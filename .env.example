# Copy to .env (apps/api reads it) and fill in. Never commit .env.

# Postgres (matches infra/docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://jt:jt@localhost:5432/jt
TEST_DATABASE_URL=postgresql+asyncpg://jt:jt@localhost:5432/jt_test

# Inngest (dev server needs no keys; set both in production)
INNGEST_DEV=true
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# LLM
ANTHROPIC_API_KEY=
LLM_MODEL_SCORE=claude-haiku-5-5
LLM_MODEL_EXTRACT=claude-haiku-5-5
LLM_MODEL_CLASSIFY_EMAIL=claude-haiku-5-5
LLM_MODEL_TAILOR=claude-sonnet-5-5
LLM_MODEL_ANSWER=claude-sonnet-5-5
LLM_DAILY_BUDGET_USD=1.00
SCORE_TOP_K=60

# ntfy push (use a long random topic: anyone who knows it can read it)
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=